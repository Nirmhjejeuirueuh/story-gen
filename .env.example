# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OPENAI_API_KEY: Optional fallback key for OpenAI / ChatGPT / DALL-E integration.
# Can also be dynamically configured inside the System Settings panel.
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# ADMIN_EMAILS: Comma-separated allowlist of accounts that may access System Settings (the
# shared API keys) and legacy pre-login data. Match the email of each Firebase Auth admin user.
ADMIN_EMAILS="admin@example.com"

